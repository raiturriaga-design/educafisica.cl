<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>EduFísica Chile V8.1</title>
<style>
:root{--navy:#061a2b;--blue:#1264ff;--cyan:#22d9ff;--teal:#10c9a2;--bg:#eef4f9;--card:#fff;--text:#172b3d;--muted:#718397;--line:#dce7ef;--shadow:0 12px 34px rgba(7,26,43,.09)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,Segoe UI,Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}
header{position:sticky;top:0;z-index:20;padding:16px 18px;color:#fff;background:linear-gradient(135deg,var(--navy),#0b3d67 60%,#096fa4);box-shadow:0 8px 25px #071a2b2b}.head{max-width:1180px;margin:auto;display:flex;justify-content:space-between;align-items:center}.logo{display:flex;gap:12px;align-items:center}.logoIcon{width:50px;height:50px;border-radius:16px;display:grid;place-items:center;font-size:27px;background:linear-gradient(135deg,var(--cyan),var(--blue))}.logo h1{margin:0;font-size:21px}.logo small{opacity:.72}.profile{padding:10px 14px;border:1px solid #ffffff24;background:#ffffff12;border-radius:18px;font-size:13px}
nav{max-width:1180px;margin:15px auto;display:flex;gap:8px;overflow:auto;padding:0 5px}nav button{border:1px solid var(--line);background:#fff;color:var(--navy);padding:11px 15px;border-radius:14px;font-weight:800;white-space:nowrap;box-shadow:0 5px 16px #071a2b0c}nav button.active{background:var(--navy);color:#fff}
main{max-width:1180px;margin:auto;padding:0 15px 70px}.page{display:none}.page.active{display:block}.hero{position:relative;overflow:hidden;color:#fff;padding:31px;border-radius:28px;margin-bottom:20px;background:linear-gradient(135deg,#061a2b,#0b4d83 57%,#1264ff);box-shadow:var(--shadow)}.hero h2{margin:0 0 8px;font-size:30px}.hero p{line-height:1.6;opacity:.9}.primary{border:0;border-radius:13px;padding:13px 18px;color:#fff;font-weight:850;background:linear-gradient(135deg,var(--blue),var(--cyan));box-shadow:0 8px 20px #1264ff30}.secondary{border:1px solid var(--line);background:#fff;color:var(--navy);padding:11px 15px;border-radius:12px;font-weight:800}.danger{border:1px solid #ffd0d0;background:#fff4f4;color:#c52b2b;padding:11px 15px;border-radius:12px;font-weight:800}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px}.stat{background:#fff;border:1px solid var(--line);border-radius:20px;padding:18px;box-shadow:var(--shadow)}.stat b{display:block;font-size:27px;color:var(--navy);margin:8px 0 3px}.stat span{font-size:13px;color:var(--muted)}
.grid,.courses{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:21px;box-shadow:var(--shadow);transition:.2s;cursor:pointer}.card:hover,.course:hover{transform:translateY(-4px)}.emoji{font-size:29px}.card h3{margin:10px 0 6px;color:var(--navy)}.card p{margin:0;color:var(--muted);font-size:14px;line-height:1.5}.cardLink{display:block;margin-top:13px;color:var(--blue);font-size:13px;font-weight:850}.course{min-height:155px;padding:23px;border-radius:22px;color:#fff;cursor:pointer;background:linear-gradient(135deg,#0b5cff,#22d9ff);box-shadow:0 12px 28px #1264ff24;transition:.2s}.course:nth-child(2n){background:linear-gradient(135deg,#07365b,#10c9a2)}.course:nth-child(3n){background:linear-gradient(135deg,#173f72,#735cff)}.course h2{margin:12px 0 6px}
.form{background:#fff;border:1px solid var(--line);border-radius:22px;padding:25px;box-shadow:var(--shadow)}.fields{display:grid;grid-template-columns:1fr 1fr;gap:17px}.full{grid-column:1/-1}.field label{display:block;font-size:13px;font-weight:850;color:var(--navy);margin-bottom:7px}select,input,textarea{width:100%;padding:13px;border:1px solid #d5e1ea;border-radius:12px;outline:0}textarea{min-height:105px;resize:vertical}.stepbar{display:flex;gap:7px;overflow:auto;margin-bottom:20px}.step{padding:9px 12px;border-radius:20px;background:#edf3f7;color:var(--muted);font-size:12px;font-weight:800;white-space:nowrap}.step.active{background:#dff8ff;color:#087a96}
.result{margin-top:20px}.plan{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);overflow:hidden}.planHead{padding:23px;background:linear-gradient(135deg,#071a2b,#0b4d83);color:#fff}.planHead h2{margin:0 0 7px}.planHead p{margin:0;opacity:.82}.chips{margin-top:12px}.tag{display:inline-block;background:#e9f8ff;color:#087b9a;padding:5px 9px;border-radius:20px;font-size:11px;font-weight:850;margin:3px}.planGrid{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:17px}.box{background:#fff;border:1px solid var(--line);border-left:5px solid var(--cyan);padding:18px;border-radius:15px}.wide{grid-column:1/-1}.timeline{display:grid;gap:10px}.timeItem{display:flex;gap:12px;padding:11px;border-radius:12px;background:#f5f9fc}.time{min-width:70px;font-weight:850;color:var(--blue)}table{width:100%;border-collapse:collapse}th,td{padding:12px;border:1px solid var(--line);text-align:left;font-size:13px;vertical-align:top}th{background:#eaf7ff;color:var(--navy)}
.saved{background:#fff;border:1px solid var(--line);border-radius:18px;padding:17px;margin:10px 0;display:flex;justify-content:space-between;align-items:center;gap:15px;box-shadow:0 6px 18px #071a2b0f}.savedTitle{font-weight:850;color:var(--navy)}.saved small{color:var(--muted)}.savedActions{display:flex;gap:8px;flex-wrap:wrap}.empty{text-align:center;padding:30px;border-radius:18px;background:#fff;border:1px dashed #cbd8e2;color:var(--muted)}
/* Visor */
.viewer{display:none;position:fixed;inset:0;background:#eef4f9;z-index:100;overflow:auto}.viewer.show{display:block}.viewerTop{position:sticky;top:0;z-index:5;background:#fff;border-bottom:1px solid var(--line);box-shadow:0 5px 20px #071a2b10}.viewerBar{max-width:1180px;margin:auto;padding:13px 15px;display:flex;align-items:center;justify-content:space-between;gap:10px}.viewerTitle{font-weight:900;color:var(--navy)}.viewerContent{max-width:1000px;margin:25px auto 60px;padding:0 15px}.viewerPlan{background:#fff;border-radius:24px;border:1px solid var(--line);box-shadow:0 15px 45px #071a2b14;overflow:hidden}.viewerPlan .planGrid{padding:22px}.viewerPlan .planHead{padding:28px}.viewerPlan .box{box-shadow:none}.toast{position:fixed;right:20px;bottom:20px;background:var(--navy);color:#fff;padding:13px 17px;border-radius:13px;opacity:0;transform:translateY(10px);transition:.25s;z-index:200}.toast.show{opacity:1;transform:none}footer{text-align:center;color:var(--muted);font-size:12px;padding:25px}
@media(max-width:900px){.grid,.courses{grid-template-columns:1fr 1fr}.stats{grid-template-columns:1fr 1fr}.planGrid{grid-template-columns:1fr}.wide{grid-column:auto}}@media(max-width:570px){.fields,.grid,.courses{grid-template-columns:1fr}.full{grid-column:auto}.profile{display:none}.hero{padding:25px}.hero h2{font-size:25px}.saved{display:block}.savedActions{margin-top:12px}.viewerBar{align-items:flex-start}.viewerBar>div:last-child{display:flex;flex-wrap:wrap;justify-content:flex-end}}
@media print{header,nav,footer,.viewerTop{display:none!important}.viewer{position:static!important;display:block!important;background:#fff}.viewerContent{margin:0;max-width:none}.viewerPlan{box-shadow:none;border:0}}
</style>
</head>
<body>
<header><div class="head"><div class="logo"><div class="logoIcon">🏃</div><div><h1>EduFísica Chile</h1><small>Plataforma docente · V8.1</small></div></div><div class="profile">👨‍🏫 Profesor</div></div></header>
<nav>
<button class="active" onclick="showPage('inicio',this)">🏠 Inicio</button><button onclick="showPage('cursos',this)">🎓 Cursos</button><button onclick="showPage('crear',this)">🤖 Crear clase</button><button onclick="showPage('oa',this)">🎯 OA</button><button onclick="showPage('rubrica',this)">📊 Rúbrica</button><button onclick="showPage('guardadas',this)">💾 Mis clases</button>
</nav>
<main>
<section id="inicio" class="page active"><div class="hero"><h2>Tu asistente para planificar Educación Física 🚀</h2><p>Construye una propuesta completa de clase con objetivo, OA orientativo, actividades, tiempos, indicadores, evaluación, inclusión y materiales.</p><button class="primary" onclick="showPage('crear')">✨ Crear mi clase</button></div>
<div class="stats"><div class="stat">🎓<b>1°–8°</b><span>Cursos disponibles</span></div><div class="stat">🎯<b>8</b><span>Niveles educativos</span></div><div class="stat">🏃<b>∞</b><span>Combinaciones</span></div><div class="stat">💾<b id="count">0</b><span>Clases guardadas</span></div></div>
<div class="grid"><div class="card" onclick="showPage('crear')"><div class="emoji">🤖</div><h3>Crear mi clase</h3><p>Genera una planificación completa.</p><span class="cardLink">Comenzar →</span></div><div class="card" onclick="showPage('oa')"><div class="emoji">🎯</div><h3>Objetivos y OA</h3><p>Consulta referencias orientativas.</p><span class="cardLink">Explorar →</span></div><div class="card" onclick="showPage('rubrica')"><div class="emoji">📊</div><h3>Rúbrica</h3><p>Crea criterios para evaluar.</p><span class="cardLink">Evaluar →</span></div><div class="card" onclick="showPage('guardadas')"><div class="emoji">💾</div><h3>Mis clases</h3><p>Administra tus planificaciones.</p><span class="cardLink">Biblioteca →</span></div></div></section>
<section id="cursos" class="page"><div class="hero"><h2>🎓 Selecciona tu curso</h2><p>Elige un nivel para abrir el generador.</p></div><div class="courses" id="courseGrid"></div></section>
<section id="crear" class="page"><div class="hero"><h2>🤖 Crear mi clase</h2><p>Completa los datos y genera una planificación estructurada.</p></div><div class="form"><div class="stepbar"><span class="step active">1 · Curso</span><span class="step active">2 · Contenido</span><span class="step">3 · Objetivo</span><span class="step">4 · Actividades</span><span class="step">5 · Evaluación</span></div>
<div class="fields"><div class="field"><label>Curso</label><select id="curso"><option value="">Seleccionar</option><option>1° Básico</option><option>2° Básico</option><option>3° Básico</option><option>4° Básico</option><option>5° Básico</option><option>6° Básico</option><option>7° Básico</option><option>8° Básico</option></select></div><div class="field"><label>Duración</label><select id="duracion"><option>45 minutos</option><option>60 minutos</option><option>90 minutos</option></select></div><div class="field"><label>Contenido</label><select id="contenido"><option value="">Seleccionar</option><option>Habilidades motrices</option><option>Fútbol</option><option>Básquetbol</option><option>Vóleibol</option><option>Handbol</option><option>Condición física</option><option>Resistencia</option><option>Fuerza</option><option>Velocidad</option><option>Coordinación</option><option>Folclore</option></select></div><div class="field"><label>Taxonomía de Bloom</label><select id="bloom"><option>Comprender</option><option>Aplicar</option><option>Analizar</option><option>Evaluar</option><option>Crear</option></select></div><div class="field"><label>Enfoque</label><select id="enfoque"><option>Desarrollo de habilidades</option><option>Cooperación y convivencia</option><option>Condición física</option><option>Iniciación deportiva</option><option>Vida activa y saludable</option></select></div><div class="field"><label>Dificultad</label><select id="nivel"><option>Progresivo</option><option>Inicial</option><option>Intermedio</option><option>Desafío</option></select></div><div class="field full"><label>Necesidad o foco específico</label><textarea id="necesidad" placeholder="Ejemplo: mejorar el pase, trabajar lateralidad, aumentar participación, adaptar para distintos niveles..."></textarea></div></div><br><button class="primary" onclick="generar()">✨ Generar planificación</button><div id="resultado" class="result"></div></div></section>
<section id="oa" class="page"><div class="hero"><h2>🎯 Objetivos y OA</h2><p>Referencias orientativas. Verifica siempre la redacción oficial vigente del MINEDUC.</p></div><div class="form"><select id="oaCurso" onchange="mostrarOA()"><option value="">Seleccionar curso</option><option>1° Básico</option><option>2° Básico</option><option>3° Básico</option><option>4° Básico</option><option>5° Básico</option><option>6° Básico</option><option>7° Básico</option><option>8° Básico</option></select><div id="oaResultado" class="result"></div></div></section>
<section id="rubrica" class="page"><div class="hero"><h2>📊 Rúbrica</h2><p>Crea una pauta de cuatro niveles para evaluación formativa.</p></div><div class="form"><div class="fields"><div class="field"><label>Curso</label><select id="rCurso"><option>1° Básico</option><option>2° Básico</option><option>3° Básico</option><option>4° Básico</option><option>5° Básico</option><option>6° Básico</option><option>7° Básico</option><option>8° Básico</option></select></div><div class="field"><label>Actividad</label><input id="rActividad" placeholder="Ejemplo: Circuito de pase y recepción"></div></div><br><button class="primary" onclick="rubrica()">📊 Crear rúbrica</button><div id="rResultado" class="result"></div></div></section>
<section id="guardadas" class="page"><div class="hero"><h2>💾 Mis clases</h2><p>Haz clic en <b>Ver completa</b> para abrir la planificación en pantalla completa. También puedes eliminarla.</p></div><div id="lista"></div></section>
</main>
<footer>EduFísica Chile V8.1 · Prototipo de plataforma docente</footer>

<div id="viewer" class="viewer">
 <div class="viewerTop"><div class="viewerBar"><div><button class="secondary" onclick="cerrarViewer()">← Volver</button> <span class="viewerTitle">📘 Vista completa de la planificación</span></div><div><button class="primary" onclick="window.print()">🖨️ Imprimir / PDF</button> <button class="danger" id="viewerDelete" onclick="eliminarDesdeViewer()">🗑️ Eliminar</button></div></div></div>
 <div class="viewerContent"><div id="viewerBody" class="viewerPlan"></div></div>
</div>
<div id="toast" class="toast"></div>

<script>
const $=id=>document.getElementById(id);
const oa={
'1° Básico':'Desarrollar habilidades motrices básicas mediante juegos y actividades físicas, favoreciendo el control corporal y la participación.',
'2° Básico':'Ejecutar habilidades motrices básicas combinando desplazamientos, saltos, lanzamientos y recepciones en situaciones lúdicas.',
'3° Básico':'Ejecutar habilidades motrices en juegos y actividades físicas, aplicando reglas simples y estrategias básicas.',
'4° Básico':'Practicar habilidades motrices y estrategias simples en juegos deportivos y actividades físicas.',
'5° Básico':'Ejecutar actividades físicas demostrando control de habilidades motrices, participación activa y hábitos de vida saludable.',
'6° Básico':'Practicar deportes y actividades físicas aplicando habilidades técnicas, tácticas, normas y actitudes de cooperación.',
'7° Básico':'Desarrollar habilidades motrices y capacidades físicas mediante actividades deportivas, recreativas y de vida activa.',
'8° Básico':'Participar en actividades físicas y deportivas aplicando habilidades motrices, estrategias y hábitos asociados a una vida activa y saludable.'
};
const bancos={'Fútbol':['Conducción libre con balón','Pases y recepción en parejas','Circuito de conducción y cambio de dirección','Juego reducido con reglas adaptadas'],'Básquetbol':['Dribling con ambas manos','Pases de pecho y pique','Circuito de dribling y lanzamiento','Juego reducido 3 contra 3'],'Vóleibol':['Toques de antebrazos en parejas','Toque de dedos sobre la cabeza','Recepción y desplazamiento','Juego reducido adaptado'],'Handbol':['Pases en movimiento','Conducción y cambio de dirección','Lanzamiento a objetivos','Juego reducido'],'Resistencia':['Activación progresiva','Circuito aeróbico por estaciones','Trote a intensidad moderada','Recuperación y respiración'],'Fuerza':['Movilidad general','Circuito de autocarga','Trabajo de tren inferior y zona media','Desafío técnico'],'Velocidad':['Reacción a estímulos','Carreras cortas','Salidas desde posiciones variadas','Relevos'],'Coordinación':['Patrones de desplazamiento','Circuito coordinativo','Lanzamiento y recepción','Desafío por estaciones'],'Folclore':['Exploración de movimientos','Desplazamientos rítmicos','Secuencia grupal','Presentación de la secuencia'],'Habilidades motrices':['Desplazamientos variados','Saltos y aterrizajes controlados','Lanzamientos y recepciones','Circuito de habilidades']};
$('courseGrid').innerHTML=[1,2,3,4,5,6,7,8].map(n=>`<div class="course" onclick="elegirCurso('${n}° Básico')"><small>Educación Básica</small><h2>${n}° Básico</h2><span>Planificar clase →</span></div>`).join('');

function showPage(id,btn){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));$(id).classList.add('active');document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));if(btn)btn.classList.add('active');if(id==='guardadas')cargar();scrollTo({top:0,behavior:'smooth'})}
function elegirCurso(c){$('curso').value=c;showPage('crear')}

function generar(){
 const c=$('curso').value,d=$('duracion').value,cont=$('contenido').value,b=$('bloom').value,enf=$('enfoque').value,niv=$('nivel').value,nec=$('necesidad').value;
 if(!c||!cont){toast('Selecciona curso y contenido');return}
 const verbo={Comprender:'comprender',Aplicar:'aplicar',Analizar:'analizar',Evaluar:'evaluar',Crear:'crear'}[b];
 const objetivo=`${verbo[0].toUpperCase()+verbo.slice(1)} y ejecutar habilidades relacionadas con ${cont.toLowerCase()}, mediante situaciones motrices progresivas, demostrando control, participación activa, cooperación y respeto por las normas.`;
 const acts=bancos[cont]||['Activación relacionada con el contenido','Circuito progresivo','Actividad cooperativa','Juego final'];
 const t=d==='45 minutos'?['8 min','27 min','10 min']:d==='60 minutos'?['10 min','38 min','12 min']:['12 min','58 min','20 min'];
 $('resultado').innerHTML=`<div class="plan"><div class="planHead"><h2>📘 Planificación de clase</h2><p>${c} · ${cont} · ${d}</p><div class="chips"><span class="tag">${enf}</span><span class="tag">${b}</span><span class="tag">${niv}</span></div></div><div class="planGrid">
<div class="box wide"><h3>🎯 Objetivo de la clase</h3><p>${objetivo}</p></div>
<div class="box"><h3>📌 OA / referencia</h3><p>${oa[c]}</p><small style="color:var(--muted)">Referencia orientativa. Contrastar con el OA oficial vigente.</small></div>
<div class="box"><h3>🧠 Enfoque</h3><p><b>${enf}</b>. Nivel: <b>${niv}</b>. Se busca que el estudiante comprenda y aplique lo trabajado en una situación motriz significativa.</p></div>
<div class="box wide"><h3>⏱️ Secuencia temporal</h3><div class="timeline"><div class="timeItem"><span class="time">${t[0]}</span><span><b>Inicio:</b> bienvenida, activación, movilidad articular y explicación del desafío.</span></div><div class="timeItem"><span class="time">${t[1]}</span><span><b>Desarrollo:</b> práctica progresiva, estaciones, retroalimentación y aplicación.</span></div><div class="timeItem"><span class="time">${t[2]}</span><span><b>Cierre:</b> vuelta a la calma, respiración, reflexión y autoevaluación breve.</span></div></div></div>
<div class="box"><h3>🏃 Actividades</h3><ul>${acts.map(x=>`<li>${x}</li>`).join('')}</ul></div><div class="box"><h3>🧰 Materiales</h3><ul><li>Conos o marcadores</li><li>Balones/material específico</li><li>Petos o elementos de identificación</li><li>Espacio delimitado y seguro</li></ul></div>
<div class="box"><h3>📋 Indicadores</h3><ul><li>Ejecuta la habilidad trabajada con control progresivo.</li><li>Participa activamente durante las tareas.</li><li>Aplica normas de seguridad y convivencia.</li><li>Utiliza retroalimentación para mejorar.</li></ul></div><div class="box"><h3>📊 Evaluación formativa</h3><p>Observación directa + preguntas breves + demostración práctica. Registrar logro, avance y aspecto a mejorar.</p></div>
<div class="box"><h3>♿ Inclusión y diversificación</h3><p>Modificar distancia, tiempo, repeticiones, espacio, material o complejidad. Permitir demostración visual y alternativas de dificultad.</p></div><div class="box"><h3>📝 Foco específico</h3><p>${nec||'Sin foco adicional. Ajustar durante la clase según observación del grupo.'}</p></div>
</div><div class="actions"><button class="primary" onclick="guardar()">💾 Guardar planificación</button><button class="secondary" onclick="window.print()">🖨️ Imprimir / PDF</button></div></div>`;
}
function guardar(){const arr=JSON.parse(localStorage.getItem('efv8')||'[]');arr.push({id:Date.now(),curso:$('curso').value,contenido:$('contenido').value,html:$('resultado').innerHTML,fecha:new Date().toLocaleDateString('es-CL')});localStorage.setItem('efv8',JSON.stringify(arr));actualizar();toast('Planificación guardada');}
let viewerId=null;
function cargar(){const arr=JSON.parse(localStorage.getItem('efv8')||'[]');$('lista').innerHTML=arr.length?arr.slice().reverse().map(x=>`<div class="saved"><div><div class="savedTitle">${x.curso} · ${x.contenido}</div><small>Guardada el ${x.fecha}</small></div><div class="savedActions"><button class="secondary" onclick="verCompleta(${x.id})">👁️ Ver completa</button><button class="danger" onclick="eliminarClase(${x.id})">🗑️ Eliminar</button></div></div>`).join(''):`<div class="empty"><div style="font-size:35px">📚</div><h3>Aún no tienes clases guardadas</h3><p>Genera una planificación y presiona “Guardar planificación”.</p></div>`}
function verCompleta(id){const x=JSON.parse(localStorage.getItem('efv8')||'[]').find(a=>a.id===id);if(!x)return;viewerId=id;$('viewerBody').innerHTML=x.html;$('viewer').classList.add('show');document.body.style.overflow='hidden'}
function cerrarViewer(){$('viewer').classList.remove('show');document.body.style.overflow='';viewerId=null}
function eliminarClase(id){if(!confirm('¿Quieres eliminar esta planificación? Esta acción no se puede deshacer.'))return;const arr=JSON.parse(localStorage.getItem('efv8')||'[]').filter(x=>x.id!==id);localStorage.setItem('efv8',JSON.stringify(arr));actualizar();cargar();toast('Planificación eliminada')}
function eliminarDesdeViewer(){if(viewerId!==null){const id=viewerId;cerrarViewer();eliminarClase(id)}}
function mostrarOA(){const c=$('oaCurso').value;$('oaResultado').innerHTML=c?`<div class="box"><span class="tag">${c}</span><h3>🎯 Objetivo orientativo</h3><p>${oa[c]}</p></div><div class="box"><h3>💡 Objetivo de clase sugerido</h3><p>Ejecutar habilidades motrices vinculadas al contenido, aplicándolas en situaciones progresivas y demostrando participación, cooperación y respeto por las normas.</p></div>`:''}
